# gtm-skill-pack MCP — config
PORT=8787

# Bearer token for the /mcp endpoint. Set this in production (one token per Foundry member).
# Leave empty for an open free-preview / local dev server.
GTM_MCP_TOKEN=

# thin = return the assembled expert prompt for the caller's model to run (no inference cost).
# thick = run server-side (Bedrock) and return the finished artifact (wire it in runSkill()).
GTM_MCP_MODE=thin
